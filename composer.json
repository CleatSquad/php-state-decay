{
    "name": "cleatsquad/php-state-decay",
    "description": "Temporal exponential half-life decay for counters and scores, in dependency-free PHP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "decay",
        "half-life",
        "exponential-decay",
        "time-decay",
        "counters",
        "statistics",
        "recency"
    ],
    "homepage": "https://github.com/cleatSquad/php-state-decay",
    "readme": "README.md",
    "authors": [
        {
            "name": "Mohamed El Mrabet",
            "email": "mimou78@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/cleatSquad/php-state-decay/issues",
        "source": "https://github.com/cleatSquad/php-state-decay"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CleatSquad\\StateDecay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleatSquad\\StateDecay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
